{
  "info": {
    "name": "FixItNow API",
    "description": "Home Service Platform backend. Base URL and token are collection variables. Run a Login request first — it auto-saves accessToken. For admin routes, run 'Login (Admin)'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "technicianId", "value": "" },
    { "key": "slotId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Customer\",\n  \"email\": \"customer@fixitnow.com\",\n  \"password\": \"123456\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register (Technician)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Technician\",\n  \"email\": \"tech@fixitnow.com\",\n  \"password\": \"123456\",\n  \"role\": \"TECHNICIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  console.log('accessToken saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@fixitnow.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  console.log('admin accessToken saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fixitnow.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Technician)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  console.log('technician accessToken saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech@fixitnow.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/my-profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "my-profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories (Public)",
      "item": [
        {
          "name": "Get all categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Categories",
      "description": "Run 'Login (Admin)' first so accessToken is an admin token.",
      "item": [
        {
          "name": "Get all categories (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "categories"]
            }
          }
        },
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.id) {",
                  "  pm.collectionVariables.set('categoryId', res.data.id);",
                  "  console.log('categoryId saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plumbing\",\n  \"icon\": \"wrench\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "categories"]
            }
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plumbing & Pipes\",\n  \"icon\": \"pipe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "categories", "{{categoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Services (Public)",
      "item": [
        {
          "name": "Get all services",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"]
            }
          }
        },
        {
          "name": "Get services (filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services?categoryId={{categoryId}}&search=AC&minPrice=100&maxPrice=5000&location=Dhaka&minRating=0&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"],
              "query": [
                { "key": "categoryId", "value": "{{categoryId}}" },
                { "key": "search", "value": "AC" },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "5000" },
                { "key": "location", "value": "Dhaka" },
                { "key": "minRating", "value": "0" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Technician - Services",
      "description": "Run 'Login (Technician)' first. Create a category (admin) to get a categoryId.",
      "item": [
        {
          "name": "Create service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.id) {",
                  "  pm.collectionVariables.set('serviceId', res.data.id);",
                  "  console.log('serviceId saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"AC Repair\",\n  \"description\": \"Fix any AC unit\",\n  \"price\": 1500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/technician/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technician", "services"]
            }
          }
        },
        {
          "name": "Update service",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1800,\n  \"title\": \"AC Repair & Service\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/technician/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technician", "services", "{{serviceId}}"]
            }
          }
        },
        {
          "name": "Delete service",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/technician/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technician", "services", "{{serviceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Technicians (Public)",
      "item": [
        {
          "name": "Get all technicians",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/technicians?location=Dhaka&minRating=0&categoryId={{categoryId}}&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technicians"],
              "query": [
                { "key": "location", "value": "Dhaka" },
                { "key": "minRating", "value": "0" },
                { "key": "categoryId", "value": "{{categoryId}}" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get technician by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/technicians/{{technicianId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technicians", "{{technicianId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Technician - Profile & Availability",
      "description": "Run 'Login (Technician)' first.",
      "item": [
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"10 years of experience\",\n  \"experienceYears\": 10,\n  \"hourlyRate\": 800,\n  \"location\": \"Dhaka\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/technician/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technician", "profile"]
            }
          }
        },
        {
          "name": "Set availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.[0]?.id) {",
                  "  pm.collectionVariables.set('slotId', res.data[0].id);",
                  "  console.log('slotId saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    { \"date\": \"2026-09-01\", \"startTime\": \"10:00\", \"endTime\": \"12:00\" },\n    { \"date\": \"2026-09-01\", \"startTime\": \"14:00\", \"endTime\": \"16:00\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/technician/availability",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technician", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings (Customer)",
      "description": "Run 'Login' (customer) first. Needs a serviceId (create as technician) and optionally a slotId.",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.id) {",
                  "  pm.collectionVariables.set('bookingId', res.data.id);",
                  "  console.log('bookingId saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"scheduledAt\": \"2026-09-01T10:00:00.000Z\",\n  \"slotId\": \"{{slotId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "Get my bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Technician - Bookings",
      "description": "Run 'Login (Technician)' first.",
      "item": [
        {
          "name": "Get assigned bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/technician/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technician", "bookings"]
            }
          }
        },
        {
          "name": "Update booking status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/technician/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technician", "bookings", "{{bookingId}}"]
            }
          }
        }
      ]
