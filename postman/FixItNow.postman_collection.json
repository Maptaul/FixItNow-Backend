    {
      "name": "Payments",
      "description": "Run 'Login' (customer) first. bookingId must be an ACCEPTED booking.",
      "item": [
        {
          "name": "Create payment session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.sessionId) {",
                  "  pm.collectionVariables.set('sessionId', res.data.sessionId);",
                  "  pm.collectionVariables.set('paymentId', res.data.paymentId);",
                  "  console.log('sessionId + paymentId saved. Open checkoutUrl in a browser, pay with test card 4242 4242 4242 4242, then run Confirm.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "create"]
            }
          }
        },
        {
          "name": "Confirm payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "confirm"]
            }
          }
        },
        {
          "name": "Get my payments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "Get payment by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "Stripe webhook (Stripe calls this)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "stripe-signature", "value": "t=0,v1=dummy" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"checkout.session.completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "webhook"]
            },
            "description": "Called by Stripe (via `stripe listen --forward-to localhost:5000/api/payments/webhook`), not manually. A manual call fails signature verification (400) by design."
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "description": "Run 'Login' (customer) first. bookingId must be a COMPLETED booking you own.",
      "item": [
        {
          "name": "Create review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
