# ---- Database ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fixitnow?schema=public"

# ---- Server ----
PORT=5000
APP_URL="https://fixit-now-frontend.vercel.app"
APP_ORIGINS="https://fixit-now-frontend.vercel.app,http://localhost:3000"

# ---- Auth ----
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET="your-access-secret"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_ACCESS_EXPIRY_IN="1d"
JWT_REFRESH_EXPIRY_IN="7d"

# ---- Stripe (note: env keys are spelled STRIPED_*) ----
STRIPED_SECRET_KEY="sk_test_..."
STRIPED_WEBHOOK_SECRET="whsec_..."
STRIPED_PRODUCT_PRICE_ID="price_..."

# ---- Seed admin credentials ----
ADMIN_EMAIL="admin@fixitnow.com"
ADMIN_PASSWORD="admin123"
